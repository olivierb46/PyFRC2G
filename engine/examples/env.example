# PyFRC2G - example .env file
#
# Copy it to ".env" in the directory where you run pyfrc2g (or use --env-file PATH), then
# protect it: chmod 600 .env. ".env" is ignored by git. Variables already set in the
# environment win over this file. Remove the lines you do not need.
# (The web application has its own .env.example in ../web/.)

# --- Single firewall (when FIREWALLS is empty in pyfrc2g/config.py) ---------------------
PYFRC2G_GATEWAY_TYPE=pfsense
PYFRC2G_GATEWAY_NAME=fw-paris
PYFRC2G_PFS_URL=https://pfs01.domain.lan
PYFRC2G_PFS_TOKEN=change-me

# OPNsense instead:
# PYFRC2G_GATEWAY_TYPE=opnsense
# PYFRC2G_OPNS_URL=https://opnsense.domain.lan
# PYFRC2G_OPNS_KEY=change-me
# PYFRC2G_OPNS_SECRET=change-me
# PYFRC2G_INTERFACES=lan,opt1

# --- Secrets referenced from FIREWALLS in pyfrc2g/config.py ------------------------------
# FIREWALLS = [{"name": "fw-lyon", "type": "opnsense", "url": "https://10.1.0.1",
#               "key": "${FW_LYON_KEY}", "secret": "${FW_LYON_SECRET}"}]
# FW_LYON_KEY=change-me
# FW_LYON_SECRET=change-me

# --- TLS -----------------------------------------------------------------------------------
PYFRC2G_VERIFY_SSL=true
# PYFRC2G_CA_BUNDLE=/etc/ssl/certs/internal-ca.pem

# --- Audit ---------------------------------------------------------------------------------
# PYFRC2G_WAN_INTERFACES=wan,wan2
# PYFRC2G_UNUSED_DAYS=30
# PYFRC2G_POLICY_FILE=examples/policy.example.yml

# --- Scheduled mode (pyfrc2g --every, docker-compose.yml) ---------------------------------
# PYFRC2G_SCHEDULE=6h

# --- Several firewalls in a JSON / YAML file (see examples/firewalls.example.yml) ---------
# PYFRC2G_FIREWALLS_FILE=/config/firewalls.yml

# --- CISO Assistant (optional) -------------------------------------------------------------
# PYFRC2G_CISO_URL=https://ciso-assistant.domain.lan
# PYFRC2G_CISO_TOKEN=change-me
# PYFRC2G_CISO_FOLDER_ID=change-me
# PYFRC2G_CISO_EVIDENCE_ID=change-me
