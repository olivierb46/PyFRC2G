# PyFRC2G reverse proxy: TLS termination, request limits, and the headers the application trusts.
# Rendered at start-up by the nginx image (variables: SERVER_NAME, HTTPS_PORT, MAX_UPLOAD_MB, see docker-compose.yml).

# Request limits per client address.
limit_req_zone $binary_remote_addr zone=pyfrc2g_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=pyfrc2g_api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=pyfrc2g_pages:10m rate=30r/s;
limit_conn_zone $binary_remote_addr zone=pyfrc2g_conn:10m;
limit_req_status 429;
limit_conn_status 429;

upstream pyfrc2g {
    server pyfrc2g-web:8080;
    keepalive 16;
}

# Plain HTTP: redirect to HTTPS on the configured name only (never to the Host header sent by the client).
server {
    listen 8080 default_server;
    server_name _;
    server_tokens off;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
    location / {
        return 301 https://${SERVER_NAME}:${HTTPS_PORT}$request_uri;
    }
}

# Any other name on HTTPS: refuse the handshake.
server {
    listen 8443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ${SERVER_NAME};
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size ${MAX_UPLOAD_MB}m;
    client_body_timeout 60s;
    client_header_timeout 20s;
    limit_conn pyfrc2g_conn 40;

    # The metrics are for the monitoring network, not for the Internet: scrape the application directly.
    location = /metrics {
        return 404;
    }

    # Sign-in (password, second factor, SSO): slow down guessing before it reaches the application.
    location ~ ^/(login|oidc/) {
        limit_req zone=pyfrc2g_login burst=10 nodelay;
        include /etc/nginx/snippets/proxy.inc;
    }

    location /api/ {
        limit_req zone=pyfrc2g_api burst=40 nodelay;
        include /etc/nginx/snippets/proxy.inc;
    }

    location / {
        limit_req zone=pyfrc2g_pages burst=60 nodelay;
        include /etc/nginx/snippets/proxy.inc;
    }
}
