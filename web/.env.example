# PyFRC2G-Web - example .env file
#
# Copy it to "web/.env" (next to docker-compose.yml, or in the directory where you run
# pyfrc2g-web) and protect it: chmod 600 .env. ".env" is ignored by git.

# Encryption key of the database: Fernet key or long passphrase. KEEP A COPY: without it the
# data cannot be read. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PYFRC2G_SECRET_KEY=change-me-to-a-long-random-value
# PYFRC2G_SECRET_KEY_OLD=previous-key-during-a-rotation

# First administrator, created at start-up when the database has no user yet
# (or run: pyfrc2g-web --create-admin NAME). Remove the password from this file afterwards.
PYFRC2G_ADMIN_USER=admin
PYFRC2G_ADMIN_PASSWORD=change-me-at-least-10-characters

# Automatic API analysis (also editable in the Settings page): 30m, 6h, 1d...
# PYFRC2G_SCHEDULE=6h

# Behind a TLS reverse proxy:
# PYFRC2G_WEB_PROXY=1
# PYFRC2G_WEB_SECURE_COOKIES=1

# PYFRC2G_WEB_HOST=127.0.0.1
# PYFRC2G_WEB_PORT=8080
# PYFRC2G_DATA_DIR=pyfrc2g-data
# PYFRC2G_WEB_MAX_UPLOAD_MB=50
