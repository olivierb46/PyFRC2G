# PyFRC2G-Web - configuration file (Docker Compose reads it).
#
#   cp .env.example .env
#   (set PYFRC2G_REDIS_PASSWORD below, put the TLS certificate in web/nginx/certs/: see the README, Prerequisites)
#   docker compose up -d --build        # then open https://localhost/
#
# Everything is optional except PYFRC2G_REDIS_PASSWORD: uncomment a line to enable a feature.
# Protect the copy (chmod 600 .env); ".env" is ignored by git.
# Keep each value on one line, without quotes or trailing comments.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Password of Redis (docker compose refuses to start without it). Generate one with:
#   openssl rand -base64 36 | tr -d '/+='
PYFRC2G_REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# First start
# ---------------------------------------------------------------------------

# First administrator, created at start-up only while the database has no user.
# CHANGE THIS PASSWORD (Account page after signing in), or remove both lines and run:
#   docker compose exec pyfrc2g-web python -m pyfrc2g_web --create-admin NAME
# The password must have at least 10 characters.
PYFRC2G_ADMIN_USER=admin
PYFRC2G_ADMIN_PASSWORD=ChangeMe-Admin-2026

# Encryption key of the database (a Fernet key or a long passphrase).
# Not set: a key is generated in the data volume (secret.key). That works, but the key then sits
# next to the database, so set your own for a real deployment and KEEP A COPY: without the key
# the data cannot be read. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# PYFRC2G_SECRET_KEY=

# Previous key, only while rotating the key (Administration > Backup & keys).
# PYFRC2G_SECRET_KEY_OLD=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Name of the site (certificate and redirection to HTTPS) and published ports. The certificate
# (web/nginx/certs/fullchain.pem and privkey.pem) must be valid for this name.
# PYFRC2G_SERVER_NAME=pyfrc2g.example.com
# PYFRC2G_HTTP_PORT=80
# PYFRC2G_HTTPS_PORT=443

# Maximum size of an uploaded configuration file, in MB.
# PYFRC2G_WEB_MAX_UPLOAD_MB=50

# Automatic analysis of the API firewalls: 30m, 6h, 1d... Also editable in Administration > Settings.
# PYFRC2G_SCHEDULE=6h

# ---------------------------------------------------------------------------
# Single sign-on (OpenID Connect)
# ---------------------------------------------------------------------------

# Enabled as soon as the issuer is set; the three first lines are then required.
# Redirect URI to declare at the identity provider: https://<your-host>/oidc/authorize
# Local accounts keep working as a fallback.
# PYFRC2G_OIDC_ISSUER=https://idp.example.com/realms/main
# PYFRC2G_OIDC_CLIENT_ID=pyfrc2g
# PYFRC2G_OIDC_CLIENT_SECRET=

# Groups (claim below) mapped to roles, comma separated. The most privileged matching role wins.
# PYFRC2G_OIDC_ADMIN_GROUPS=pyfrc2g-admins
# PYFRC2G_OIDC_OPERATOR_GROUPS=pyfrc2g-operators
# PYFRC2G_OIDC_AUDITOR_GROUPS=pyfrc2g-auditors
# PYFRC2G_OIDC_VIEWER_GROUPS=pyfrc2g-viewers

# Optional: only these groups (and the ones above) may sign in. Others are refused.
# PYFRC2G_OIDC_ALLOWED_GROUPS=pyfrc2g-users

# Role of a user matching no group: admin, operator, auditor or viewer (default).
# PYFRC2G_OIDC_DEFAULT_ROLE=viewer

# Names of the claims holding the groups and the user name.
# An SSO session lasts at most this many minutes (minimum 5): then the user goes back to the identity provider,
# so that an account revoked there, or a changed group, is noticed. Local sessions last 12 hours.
# PYFRC2G_OIDC_REVALIDATE_MINUTES=60

# Advanced: scopes asked to the provider, how the client secret is sent (client_secret_post or client_secret_basic),
# and the callback URL when the application cannot guess it behind a proxy.
# PYFRC2G_OIDC_SCOPES=openid email profile
# PYFRC2G_OIDC_AUTH_METHOD=client_secret_post
# PYFRC2G_OIDC_REDIRECT_URI=https://pyfrc2g.example.com/oidc/authorize

# PYFRC2G_OIDC_GROUPS_CLAIM=groups
# PYFRC2G_OIDC_USERNAME_CLAIM=preferred_username

# ---------------------------------------------------------------------------
# Two-factor authentication (TOTP) of the local accounts
# ---------------------------------------------------------------------------

# Optional for everybody by default (My account > Two-factor authentication).
# admin = administrators must enrol, all = every local user must. SSO users are not concerned.
# PYFRC2G_MFA_REQUIRED=admin

# ---------------------------------------------------------------------------
# Protection of the sign-in against guessing (see README: Security)
# ---------------------------------------------------------------------------

# Failures of a (user name, address) pair that lock it; the lock starts at LOCK_MINUTES and doubles each time
# the same one comes back, up to MAX_LOCK_HOURS. An address failing on many names is locked at 4 times the limit.
# PYFRC2G_LOGIN_MAX_FAILURES=5
# PYFRC2G_LOGIN_LOCK_MINUTES=10
# PYFRC2G_LOGIN_MAX_LOCK_HOURS=24

# ---------------------------------------------------------------------------
# Sessions and accepted risks
# ---------------------------------------------------------------------------

# Simultaneous sessions allowed per user; the oldest is closed. 0 = no limit.
# PYFRC2G_MAX_SESSIONS=3

# 1 = an accepted risk must be approved by another administrator, even an administrator's own.
# PYFRC2G_RISK_FOUR_EYES=1

# Days before an expiry date at which the "accepted risk expiring" event is raised (default 14).
# PYFRC2G_RISK_REMINDER_DAYS=14

# ---------------------------------------------------------------------------
# Audit export to a SIEM (one JSON object per event)
# ---------------------------------------------------------------------------

# Syslog target: udp://host:514, tcp://host:514 or unix:///dev/log
# PYFRC2G_AUDIT_SYSLOG=udp://syslog.example.com:514

# HTTPS webhook receiving the events, with an optional HMAC signature (X-PyFRC2G-Signature) and
# an optional bearer token.
# PYFRC2G_AUDIT_WEBHOOK=https://siem.example.com/pyfrc2g
# PYFRC2G_AUDIT_WEBHOOK_SECRET=
# PYFRC2G_AUDIT_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------

# Prometheus: scrape /metrics with the header "Authorization: Bearer <this token>". Not set: /metrics is off.
# Generate it with: openssl rand -hex 32
# PYFRC2G_METRICS_TOKEN=

# ---------------------------------------------------------------------------
# Notifications and scheduled reports by email
# (channels and schedules are edited in Administration > Notifications)
# ---------------------------------------------------------------------------

# Mail server. Security: starttls (default, port 587), ssl (port 465) or none (this machine only).
# PYFRC2G_SMTP_HOST=smtp.example.com
# PYFRC2G_SMTP_PORT=587
# PYFRC2G_SMTP_SECURITY=starttls
# PYFRC2G_SMTP_USER=pyfrc2g
# PYFRC2G_SMTP_PASSWORD=
# PYFRC2G_SMTP_FROM=pyfrc2g@example.com

# Public URL of the application, used for the links in the messages.
# PYFRC2G_BASE_URL=https://pyfrc2g.example.com

# Recommended: recipients limited to these domains, comma separated.
# PYFRC2G_MAIL_ALLOWED_DOMAINS=example.com

# Extra host suffixes accepted for Slack / Teams webhooks (comma separated), and 1 to let a
# webhook target a private address (internal collector only).
# PYFRC2G_NOTIFY_WEBHOOK_HOSTS=
# PYFRC2G_NOTIFY_ALLOW_PRIVATE=1
